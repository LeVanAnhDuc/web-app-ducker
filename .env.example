# Answers: Which environment variables are needed to run?
# Status: 🟢 complete — mirrors what the code actually reads
# Update when: code starts reading a new variable, or stops reading one
#
# The site needs none to build. Content is files under `content/` (ADR-0018) and
# there is no administration surface (ADR-0019), so there is no database, no auth
# secret and no object store left to configure. `pnpm build` succeeds with no
# environment variables at all; `GITHUB_TOKEN` below is optional.

# Cổng cho server riêng của Playwright (playwright.config.ts). Bỏ trống = 3210.
E2E_PORT=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Raises the GitHub API limit from 60 to 5,000 requests an hour for the
# README and Releases tabs (ADR-0023). One clean build makes about 42 calls, so two
# clean builds within an hour from one machine run out without it. No scopes are
# needed — every repository read is public. In production it must be set on the
# host itself (a Vercel project variable): the hourly ISR refreshes run there, not
# in CI.
GITHUB_TOKEN=
